# ICMIS Web Operations Dashboard environment
# Copy to .env.local and adjust for the Raspberry Pi on your network.

# Leave blank to talk to whatever host is serving the bundle (the Pi itself, once built).
# Set it explicitly when running `npm run dev` against a remote Pi.
VITE_API_BASE_URL=

# Matches ICMIS_API_KEY on the backend; sent as X-API-Key on REST and ?token= on the WebSocket.
VITE_API_KEY=
